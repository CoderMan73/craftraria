{
	"schemaVersion": 1,
	"id": "craftraria",
	"version": "${version}",
	"name": "Craftraria",
	"description": "Run the genuine Terraria inside Minecraft Java Edition via an embedded Chromium browser (Rinku), served from the player's own install.",
	"authors": [
		"craftraria"
	],
	"contact": {
		"sources": "https://github.com/CoderMan73/craftraria"
	},
	"license": "GPL-3.0",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.craftraria.CraftrariaMod"
		],
		"client": [
			"com.craftraria.client.CraftrariaClient"
		],
		"modmenu": [
			"com.craftraria.client.ui.CraftrariaModMenuApi"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"rinku": "*",
		"cloth-config": "*"
	}
}
